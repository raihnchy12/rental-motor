# ==========================================
# WEB RENTAL MOTOR YOGYAKARTA - ENVIRONMENT CONFIGURATION
# ==========================================
# Salin file ini menjadi .env atau .env.local dan isi nilainya sesuai environment kamu.
# 
# Tips membuat secret key random (minimal 32 karakter):
#   openssl rand -base64 32
#   openssl rand -hex 32
# ==========================================

# --- DATABASE ---
DATABASE_URL="postgresql://user:password@localhost:5432/rental_motor?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/rental_motor?schema=public"

# --- AUTHENTICATION ---
# Wajib diisi (minimal 32 karakter)
AUTH_SECRET="ganti_dengan_openssl_rand_base64_32_karakter_disini"
AUTH_URL="http://localhost:3000"

# --- CLOUD STORAGE (S3 / COMPATIBLE STORAGE) ---
# Opsional di development, wajib di production
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- NOTIFIKASI & EMAIL (RESEND) ---
# Opsional di development, wajib di production
RESEND_API_KEY=""
EMAIL_FROM="noreply@rentalmotor.com"

# --- MONITORING & KEAMANAN ---
# Sentry DSN (Opsional di dev, wajib di production)
SENTRY_DSN=""

# Cron Secret untuk tugas otomatis backend (Wajib, minimal 32 karakter)
CRON_SECRET="ganti_dengan_cron_secret_minimal_32_karakter_disini"

# Cloudflare Turnstile CAPTCHA (Opsional di dev, wajib di production)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- APLIKASI ---
# Wajib diisi
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- SENTRY MONITORING ---
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
ENABLE_DEBUG_ROUTES="false"